generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique
  name String
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model WeatherLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  latitude    Float
  longitude   Float
  temperature Float    
  humidity    Int      
  windSpeed   Float    
  condition   Int  
  conditionString String    
  precipitationProb Int      @default(0)
  collectedAt DateTime
  createdAt   DateTime @default(now())
  
  fullData    Json?    

  @@map("weather_logs")
}
